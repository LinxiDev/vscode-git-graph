{
	"compilerOptions": {
		"lib": [
			"es6",
			"dom",
			"es2016.array.include"
		],
		"module": "none",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "../media",
		"removeComments": true,
		"strict": true,
		"target": "es5",
		"types": [
			"node"
		]
	}
}
